{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadith.schema.json",
  "title": "Hadith item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text_ar",
    "narrator",
    "graded_by",
    "sources",
    "grade",
    "category",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "معرّف فريد عبر كل المحتوى، مثل arbaeen-nawawi-001"
    },
    "text_ar": {
      "type": "string",
      "minLength": 1,
      "description": "نص الحديث بالعربية"
    },
    "narrator": {
      "type": "string",
      "minLength": 1,
      "description": "الراوي من الصحابة"
    },
    "graded_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "من خرّجه في الصحيح أو حكم عليه، مثل البخاري أو الترمذي"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book", "number"],
        "properties": {
          "book": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "minLength": 1 }
        }
      },
      "description": "المصدر ورقم الحديث"
    },
    "grade": {
      "type": "string",
      "enum": ["sahih", "hasan", "daif", "mawdu"],
      "description": "درجة الحديث"
    },
    "agreed_upon": {
      "type": "boolean",
      "description": "متفق عليه (البخاري ومسلم)"
    },
    "category": {
      "type": "string",
      "enum": ["authentic", "warning"],
      "description": "authentic للمعتمد، warning لقسم التحذير (الضعيف والموضوع فقط)"
    },
    "topics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "editor_note": {
      "type": "string",
      "description": "ملاحظة للمراجع، لا تظهر للمستخدم"
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "published"]
    },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "grade": { "enum": ["daif", "mawdu"] } },
        "required": ["grade"]
      },
      "then": {
        "properties": { "category": { "const": "warning" } }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "warning" } },
        "required": ["category"]
      },
      "then": {
        "properties": { "grade": { "enum": ["daif", "mawdu"] } }
      }
    },
    {
      "if": {
        "properties": { "review_status": { "enum": ["reviewed", "published"] } },
        "required": ["review_status"]
      },
      "then": {
        "required": ["reviewer", "reviewed_at"]
      }
    }
  ]
}
